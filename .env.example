# =============================================================================
# Wakeel AI Service — environment template
# =============================================================================
# Copy this file to .env and replace every placeholder with a real value.
# .env is git-ignored and must NEVER be committed.
#
# The service fails fast (exit code 1) at startup when any of the three
# required credentials below is missing or empty:
#   WAKEEL_INTERNAL_API_KEY, MONGODB_URI, LLM_API_KEY
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000

# --- MongoDB (chat history + Atlas Vector Search knowledge base) --------------
# REQUIRED. Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster>/
MONGODB_URI=replace_me_with_your_mongodb_connection_string
MONGODB_DB_NAME=wakeel_ai

# --- LLM provider ------------------------------------------------------------
# iti | groq | google
LLM_PROVIDER=iti
# REQUIRED. API key for the provider selected above.
LLM_API_KEY=replace_me_with_your_llm_api_key
LLM_MODEL=gpt-4o
# Optional. OpenAI-compatible base URL. Used by the "iti" provider.
LLM_BASE_URL=https://replace-me.example.com/v1

# Optional provider-specific Google Gemini configuration (used when LLM_PROVIDER=google)
GOOGLE_API_KEY=replace_me_with_your_google_api_key
GOOGLE_MODEL=gemini-2.5-flash

# --- Embeddings --------------------------------------------------------------
HUGGINGFACE_API_KEY=replace_me_with_your_huggingface_token
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-m3

# --- Wakeel .NET backend (internal service-to-service calls) -----------------
WAKEEL_API_BASE_URL=https://wakeel-ai-api.runasp.net
# REQUIRED. Must match the backend's configured internal key. Sent as the
# X-Internal-API-Key header on every outbound /api/ai/* call.
WAKEEL_INTERNAL_API_KEY=replace_me_with_the_shared_internal_api_key

# --- Knowledge retrieval (Atlas Vector Search) -------------------------------
VECTOR_INDEX_NAME=default_vector_index
KNOWLEDGE_RETRIEVAL_TOP_K=5
KNOWLEDGE_CHUNK_SIZE=1200

# --- Initial labour-law knowledge bootstrap ----------------------------------
INITIAL_LABOR_LAW_DOCUMENT_ID=egyptian-labor-law
INITIAL_LABOR_LAW_TITLE=Egyptian Labor Law
INITIAL_LABOR_LAW_VERSION=initial
INITIAL_LABOR_LAW_SOURCE_PATH=knowledge/egypt-labor-law-14-2025.pdf
